{
  "name": "nyxen-minecraft",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.0",
  "scripts": {
    "dev": "bun --env-file=.env run dev:app",
    "dev:app": "vite build && concurrently -k -n vite,electrobun \"vite build --watch\" \"cross-env CES_DEV_RELOAD=1 electrobun dev\"",
    "build": "bun --env-file=.env run build:app",
    "build:app": "vite build && electrobun build --env=dev --targets=all",
    "build:release": "vite build && electrobun build --env=stable",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome check --write .",
    "check": "turbo run typecheck lint test",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-router": "^1.166.6",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "electrobun": "^1.16.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.14.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.75.0",
    "react-resizable-panels": "^4.11.0",
    "recharts": "3.8.0",
    "shadcn": "^3.6.2",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.10",
    "tw-animate-css": "^1.3.4",
    "vaul": "^1.1.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@tailwindcss/vite": "^4.1.10",
    "@tanstack/router-plugin": "^1.167.35",
    "@types/bun": "^1.3.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.9",
    "turbo": "^2.6.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  }
}
