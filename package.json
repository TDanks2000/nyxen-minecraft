{
  "name": "nyxen-minecraft",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun --env-file=.env run dev:app",
    "dev:app": "vite build && concurrently -k -n vite,electrobun \"vite build --watch\" \"cross-env CES_DEV_RELOAD=1 electrobun dev\"",
    "build": "bun --env-file=.env run build:app",
    "build:app": "vite build && electrobun build --env=dev --targets=all",
    "build:release": "vite build && electrobun build --env=stable",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome check --write .",
    "check": "turbo run typecheck lint test",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-router": "1.170.6",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.2.1",
    "drizzle-orm": "^0.45.2",
    "electrobun": "^1.18.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.16.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.0",
    "react-resizable-panels": "^4.11.1",
    "recharts": "3.8.1",
    "shadcn": "4.7.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/router-plugin": "1.168.9",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  }
}
